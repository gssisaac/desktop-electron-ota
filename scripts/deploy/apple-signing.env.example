# Copy to scripts/deploy/apple-signing.env (gitignored).
# Variable names are the ones electron-builder and notarytool read directly.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID=TEAMID

# App Store Connect API key (recommended).
# APPLE_API_KEY is the path to the .p8 file; a relative path resolves against this file.
APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Or an Apple ID + app-specific password:
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Or a notarytool keychain profile created with `xcrun notarytool store-credentials`:
# NOTARYTOOL_PROFILE=__APP_SLUG__-notary
